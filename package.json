{
  "name": "notas",
  "version": "1.0.0",
  "private": true,
  "author": "kevinincavalcante <kevinin.santos@gmail.com>",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:init": "node scripts/init-db.mjs",
    "db:rebuild": "node scripts/init-db.mjs --rebuild-fts",
    "test:sync": "tsx scripts/test-sync.mts",
    "test:auto-list": "tsx scripts/test-auto-list.mts",
    "apk": "bash scripts/build-apk.sh",
    "test:sync:replica": "tsx scripts/test-sync-replica.mts",
    "test:sync:mobile": "tsx scripts/test-sync-mobile.mts",
    "electron:bundle": "esbuild electron/main.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist-electron/main.cjs && cp electron/preload.cjs dist-electron/preload.cjs",
    "electron:start": "npm run build && npm run electron:bundle && electron .",
    "electron:deb": "npm run build && npm run electron:bundle && electron-builder --linux deb"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1166.0",
    "@libsql/client": "^0.18.0",
    "@tailwindcss/typography": "^0.5.20",
    "bcryptjs": "^3.0.3",
    "highlight.js": "^11.12.0",
    "jose": "^6.2.17",
    "lucide-react": "^1.71.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "electron@45.3.0": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
