{
  "expo": {
    "name": "Notas",
    "slug": "notas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "notas",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.kevinincavalcante.notas",
      "adaptiveIcon": {
        "backgroundColor": "#101012",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        { "action": "SEND", "category": ["DEFAULT"], "data": { "mimeType": "text/plain" } },
        { "action": "SEND", "category": ["DEFAULT"], "data": { "mimeType": "image/*" } },
        { "action": "SEND", "category": ["DEFAULT"], "data": { "mimeType": "audio/*" } },
        { "action": "SEND", "category": ["DEFAULT"], "data": { "mimeType": "video/*" } },
        { "action": "SEND_MULTIPLE", "category": ["DEFAULT"], "data": { "mimeType": "image/*" } },
        { "action": "SEND_MULTIPLE", "category": ["DEFAULT"], "data": { "mimeType": "audio/*" } },
        { "action": "SEND_MULTIPLE", "category": ["DEFAULT"], "data": { "mimeType": "video/*" } }
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101012",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "O app precisa de acesso às fotos para anexar às notas.",
          "cameraPermission": "O app precisa de acesso à câmera para tirar fotos das notas."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
