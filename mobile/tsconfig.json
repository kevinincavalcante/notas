{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      // Código compartilhado com o servidor (lib/) — usado só como type,
      // nunca empacotado. O prefixo mais longo vence: "@/lib/*" manda
      // pro repo, o resto do "@/..." vai pro src do app.
      "@/lib/*": ["../lib/*"],
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
