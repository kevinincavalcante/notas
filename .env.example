# ==========================================
# Banco de Dados (Turso / libSQL)
# ==========================================
TURSO_LINK=libsql://seu-banco.turso.io
TURSO_TOKEN=seu_token_aqui_jwt_turso

# ==========================================
# Autenticação de Usuário Único
# ==========================================
APP_USER=admin
# Hash Bcrypt da senha (use: node scripts/hash-password.mjs "sua_senha")
APP_PASSWORD_HASH="\$2b\$10\$exemploDeHashBcryptComEscapeParaNextJs..."
# Ou se preferir usar senha direta em texto puro:
# APP_PASSWORD=sua_senha_aqui

# Segredo para assinatura do JWT (ex: chave aleatória de 32 bytes em hex)
JWT_SECRET=sua_chave_secreta_jwt_longa_aqui

# ==========================================
# Armazenamento de Anexos (Cloudflare R2 - Recomendado)
# ==========================================
R2_ENDPOINT=https://<SUA_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=sua_access_key_id
R2_SECRET_ACCESS_KEY=sua_secret_access_key
R2_BUCKET_NAME=nome-do-seu-bucket

# ==========================================
# Armazenamento Alternativo (Box API - Opcional)
# ==========================================
# BOX_CLIENT_ID=seu_client_id
# BOX_CLIENT_SECRET=seu_client_secret
# BOX_ENTERPRISE_ID=seu_enterprise_id
# BOX_FOLDER_ID=0
